# Configuración del servicio de sincronización WhatsApp del CRM
# Copia este archivo a .env y completa los valores (nunca subas .env al repo).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nombre con el que aparece el dispositivo vinculado en WhatsApp
DEVICE_NAME=WhatsApp Ush CRM
# Puerto del mini servidor de estado local (opcional). 0 para desactivar.
STATUS_PORT=3170
# Cada cuántos segundos se revisa la cola de salida
OUTBOX_POLL_SECONDS=5